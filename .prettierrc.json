{
  "$schema": "https://json.schemastore.org/prettierrc",
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": true,
  "printWidth": 100,
  "plugins": [
    "@ianvs/prettier-plugin-sort-imports",
    "prettier-plugin-packagejson",
    "prettier-plugin-jsdoc",
    "prettier-plugin-organize-attributes"
  ],
  "importOrder": [
    "^vue$",
    "^vue-router$",
    "^vuex$",
    "^vuetify",
    "^firebase",
    "<THIRD_PARTY_MODULES>",
    "^@/(.*)$",
    "^[./]"
  ],
  "attributeGroups": [
    "^(:?is|v-is)$",
    "^v-for$",
    "^(v-if|v-else-if|v-else|v-show|v-cloak)$",
    "^(v-once|v-pre)$",
    "^id$",
    "^(ref|key|v-slot|slot)$",
    "^v-model",
    "^v-",
    "$DEFAULT",
    "^(@|v-on:)",
    "^(v-html|v-text)$"
  ]
}
