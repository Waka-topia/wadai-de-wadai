{
  "$schema": "https://json.schemastore.org/prettierrc",
  "semi": false,
  "singleQuote": true,
  "printWidth": 100,
  "plugins": [
    "@ianvs/prettier-plugin-sort-imports",
    "prettier-plugin-packagejson",
    "prettier-plugin-jsdoc",
    "prettier-plugin-organize-attributes"
  ],
  "importOrder": [
    "^vue$",
    "^vue-router$",
    "^vuex$",
    "^vuetify",
    "^firebase",
    "<THIRD_PARTY_MODULES>",
    "^@/(.*)$",
    "^[./]"
  ],
  "attributeGroups": ["$CODE_GUIDE"]
}
