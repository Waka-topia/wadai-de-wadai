{
  "name": "wadai-de-wadai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:revival": "vite build --mode revival",
    "deploy:revival": "firebase use revival && npm run build:revival && firebase deploy --only hosting",
    "deploy:revival:rules": "firebase use revival && firebase deploy --only firestore:rules,firestore:indexes",
    "dev": "vite --mode revival",
    "format": "prettier --write .",
    "lint": "eslint . --fix",
    "prepare": "husky",
    "preview": "vite preview",
    "preview:revival": "firebase use revival && npm run build:revival && firebase hosting:channel:deploy revival-test --expires 7d"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@mdi/font": "^7.4.47",
    "@mdi/js": "^7.4.47",
    "firebase": "^12.7.0",
    "register-service-worker": "^1.7.2",
    "uuid": "^13.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "vue": "^3.5.26",
    "vue-cal": "^4.10.2",
    "vue-qrcode-reader": "^5.7.3",
    "vue-router": "^4.6.4",
    "vuetify": "^3.11.6",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "eslint": "^9.39.2",
    "eslint-plugin-check-file": "^3.3.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^62.0.0",
    "eslint-plugin-vue": "^10.6.2",
    "husky": "^9.1.7",
    "prettier": "^3.7.4",
    "prettier-plugin-jsdoc": "^1.8.0",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "prettier-plugin-packagejson": "^2.5.20",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
