rules_version = '2';

// ============================================================
// ワダイdeワダイ - Firestore セキュリティルール
// ============================================================
// 設計方針:
//   1. 未ログインでも閲覧できる公開コレクションは明示的に allow read: if true
//   2. ログインが必要な操作は request.auth != null で制御
//   3. 自分のデータ以外の書き込みは原則禁止
//   4. 管理者（ADMIN_UID）は全操作許可
//   5. groups コレクションの write は現状認証済みに許可（Cloud Functions 移行までの暫定）
//   6. 未定義コレクションはデフォルト拒否（Firestore の暗黙ルール）
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // ヘルパー関数
    // ============================================================

    /** リクエスト元が認証済みユーザーかどうか */
    function isAuthenticated() {
      return request.auth != null;
    }

    /** リクエスト元が対象ユーザー本人かどうか */
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    /**
     * リクエスト元が管理者かどうか
     * ※ このUIDはサーバーサイドで評価されるため、クライアントには公開されない
     */
    function isAdmin() {
      return isAuthenticated() &&
        request.auth.uid == "Nc9QmDtACiZc7wC4wXTiNRKztoP2";
    }

    // ============================================================
    // users コレクション（ユーザープロフィール・ブックマーク等）
    // users/{uid}
    // ============================================================
    match /users/{uid} {
      // 読み取り・書き込みは本人または管理者のみ
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) || isAdmin();

      // stampsReceived サブコレクション
      // 読み取り: 本人・管理者のみ
      // 作成: QRスキャンの仕様上、認証済みユーザーなら他人のスタンプを付与できる
      // 更新・削除: 管理者のみ
      match /stampsReceived/{stampId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isAuthenticated();
        allow update, delete: if isAdmin();
      }
    }

    // ============================================================
    // ユーザー時間割データ（1学期1ドキュメント構造）
    // user_timetables/{uid}/semesters/{semesterDocId}
    // ============================================================
    match /user_timetables/{uid}/{document=**} {
      // 本人のデータのみ読み書き可能
      allow read: if isOwner(uid) || isAdmin();
      allow write: if (isOwner(uid) || isAdmin()) && isValidTimetableWrite();
    }

    // ============================================================
    // スタンプマスタ
    // stamps/{stampId}
    // ============================================================
    match /stamps/{stampId} {
      // 読み取り: 認証済みユーザー（スタンプ画像取得に必要）
      allow read: if isAuthenticated();
      // 書き込み: 管理者のみ（スタンプ定義の追加・変更）
      allow write: if isAdmin();
    }

    // ============================================================
    // イベント（月別ハッシュ化コレクション）
    // events_monthly_hashed/{monthKey}
    // ============================================================
    match /events_monthly_hashed/{monthKey} {
      // 読み取り: 全員（未ログインでも閲覧可能 ― 設計方針通り）
      allow read: if true;
      // 書き込み: 認証済みユーザー
      // ※ 所有権チェック（自分のイベントかどうか）はアプリ側 verifyEventOwnership で実施
      allow write: if isAuthenticated();
    }

    // ============================================================
    // イベント（旧コレクション・レガシー互換）
    // events/{eventId}
    // ============================================================
    match /events/{eventId} {
      // 読み取り: 全員（未ログインでも閲覧可能）
      allow read: if true;
      // 作成: ログイン済みユーザーが自分のIDで作成
      allow create: if isAuthenticated() &&
        request.resource.data.createdBy == request.auth.uid;
      // 更新・削除: 作成者本人または管理者
      allow update, delete: if isAuthenticated() &&
        (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // ============================================================
    // 代表者証明申請
    // proveApplications/{applicationId}
    // ============================================================
    match /proveApplications/{applicationId} {
      // 読み取り: 自分の申請のみ、または管理者
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());

      // 新規申請の作成: 認証済みユーザーが自分のUIDで申請
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;

      // 更新・削除: 管理者のみ（承認・却下操作）
      allow update, delete: if isAdmin();
    }

    // ============================================================
    // 承認済み代表者（レガシー互換）
    // groupRepresentatives/{groupId_userId}
    // ============================================================
    match /groupRepresentatives/{representativeId} {
      // 読み取り: 自分のレコードまたは管理者
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      // 書き込み: 管理者のみ（承認フロー経由でのみ作成される）
      allow write: if isAdmin();
    }

    // ============================================================
    // 団体マスターデータ・代表者管理
    // groups/{groupId}
    // ⚠️ 暫定ルール: 代表者登録トランザクションがクライアントから実行されるため
    //    書き込みを認証済みユーザーに許可している。
    //    将来的に Cloud Functions へ移行後、isAdmin() に変更予定。
    // ============================================================
    match /groups/{groupId} {
      // 読み取り: 全員（団体一覧は公開 ― 未ログインでも閲覧可能）
      allow read: if true;
      // 書き込み: 認証済みユーザー（暫定）
      allow write: if isAuthenticated();
    }

    // ============================================================
    // 楽単レビュー
    // lecture_reviews/{lectureName}
    // ============================================================
    match /lecture_reviews/{lectureName} {
      // 読み取り: 認証済みユーザー
      allow read: if isAuthenticated();
      // 書き込み: 認証済みユーザー（平均・カウントのトランザクション更新を含む）
      allow write: if isAuthenticated();

      match /ratings/{ratingUid} {
        // 読み取り: 認証済みユーザー
        allow read: if isAuthenticated();
        // 書き込み: 自分の評価のみ
        allow write: if isOwner(ratingUid);
      }
    }

    // ============================================================
    // 施設評価（マップ上のトイレ・勉強スペース等）
    // ratings/{ratingId}
    // ============================================================
    match /ratings/{ratingId} {
      // 読み取り: 認証済みユーザー（地図機能はログイン後）
      allow read: if isAuthenticated();
      // 作成: 認証済みユーザーが自分のUIDで投稿
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      // 更新・削除: 管理者のみ
      allow update, delete: if isAdmin();
    }

    // ============================================================
    // Wikipedia型シラバス
    // lecture_syllabuses/{lectureName}
    // ============================================================
    match /lecture_syllabuses/{lectureName} {
      // 読み取り: 認証済みユーザー
      allow read: if isAuthenticated();
      // 書き込み: 認証済みユーザー（共同編集の仕様）
      allow write: if isAuthenticated();
    }

    // ============================================================
    // シラバス検索インデックス
    // lecture_search/{docId}  ← lecture_search/all_lectures_index を使用
    // ============================================================
    match /lecture_search/{docId} {
      // 読み取り: 認証済みユーザー
      allow read: if isAuthenticated();
      // 書き込み: 認証済みユーザー（saveSyllabusWithIndex のトランザクション）
      allow write: if isAuthenticated();
    }

    // ============================================================
    // 講義マスターインデックス（旧パス・レガシー互換）
    // lecture_index/{docId}
    // ============================================================
    match /lecture_index/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ============================================================
    // ヘルパー関数
    // ============================================================

    /**
     * 時間割ドキュメントのバリデーション
     * 想定されたトップレベルフィールドを持つことを検証する
     */
    function isValidTimetableWrite() {
      return request.method == 'delete'
        || request.resource.data.keys().hasAny(['lectures', 'updatedAt']);
    }

  }
}
