rules_version = '2';

// ============================================================
// ワダイdeワダイ 2025年4月復刻版 - Firestore セキュリティルール
// ============================================================
// 設計方針:
//   1. users は本人のみ read/write（email を含むため他者に開放しない）
//   2. ランキング表示用の公開情報は rankingEntries に分離して個人情報を含めない
//   3. スタンプのマスターは src/data/stamps.js の静的定義（Firestore を使わない）
//   4. stampsReceived は create のみ許可し、二重取得をルール側で拒否する
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // ユーザードキュメント
    // users/{uid}
    // ============================================================
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // ============================================================
      // 取得済みスタンプ
      // users/{uid}/stampsReceived/{stampId}
      // ============================================================
      match /stampsReceived/{stampId} {
        allow read: if request.auth != null && request.auth.uid == uid;

        // 新規取得のみ許可する
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['groupId', 'stampId', 'receivedAt'])
          && request.resource.data.stampId == stampId;

        // 一度取得したスタンプは書き換え不可。
        // grantStamp はこの拒否を「取得済み」の判定に使っており、
        // バッチ全体がロールバックすることで stampCount の二重加算も防いでいる。
        allow update: if false;

        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ============================================================
    // ランキング表示用の公開プロジェクション（個人情報を含めない）
    // rankingEntries/{uid}
    // ============================================================
    match /rankingEntries/{uid} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.userId == uid
        && request.resource.data.stampCount == 1
        && request.resource.data.keys().hasOnly(['userId', 'displayName', 'stampCount', 'updatedAt']);

      // 1回のスタンプ取得につき +1 のみ許可
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.userId == uid
        && request.resource.data.stampCount == resource.data.stampCount + 1
        && request.resource.data.keys().hasOnly(['userId', 'displayName', 'stampCount', 'updatedAt']);

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ============================================================
    // 団体マスター
    // groups/{groupId}
    // 復刻版は代表者証明の申請フローを持たないため書き込みは不可。
    // 結果として isUserRepresentative は常に false となり、
    // すべてのイベントが一般（非公式）扱いになる。
    // ============================================================
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ============================================================
    // イベント
    // events/{eventId}
    // ============================================================
    match /events/{eventId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;

      allow update, delete: if request.auth != null
        && resource.data.createdBy == request.auth.uid;
    }

    // ============================================================
    // 月別イベント (ハッシュ化対応)
    // events_monthly_hashed/{monthKey}
    // ============================================================
    match /events_monthly_hashed/{monthKey} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ============================================================
    // その他のコレクションはデフォルトで拒否（暗黙的）
    // ============================================================
  }
}
