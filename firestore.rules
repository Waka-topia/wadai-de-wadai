rules_version = '2';

// ============================================================
// ワダイdeワダイ - Firestore セキュリティルール
// ============================================================
// 設計方針:
//   1. 認証済みユーザーのみ読み書き可
//   2. 自分のデータ以外は読み書き不可（UID でアクセス制御）
//   3. lecture_index は全認証ユーザーが読める（サジェスト用）
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // ユーザー時間割データ（最適化後：1学期1ドキュメント）
    // user_timetables/{uid}/semesters/{semesterDocId}
    //   ドキュメント構造: { lectures: { "mon-1": {...} }, updatedAt: "..." }
    // ============================================================
    match /user_timetables/{uid}/{document=**} {
      // 自分のデータのみ読み書き可能
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && isValidTimetableWrite();
    }

    // ============================================================
    // 講義マスターインデックス（全ユーザー共有のサジェスト用）
    // ============================================================
    match /lecture_index/{docId} {
      // 認証済みユーザーなら誰でも読める
      allow read: if request.auth != null;

      // 書き込みは認証済みユーザーのみ
      allow write: if request.auth != null;
    }

    // ============================================================
    // 楽単レビュー
    // ============================================================
    match /lecture_reviews/{lectureName} {
      allow read: if request.auth != null;
      // 平均とカウントのトランザクション更新を許可
      allow write: if request.auth != null;

      match /ratings/{ratingUid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == ratingUid;
      }
    }

    // ============================================================
    // Wikipedia型シラバス
    // ============================================================
    match /lecture_syllabuses/{lectureName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ============================================================
    // 代表者証明申請（V2）
    // proveApplications/{applicationId}
    // ============================================================
    match /proveApplications/{applicationId} {
      allow read: if request.auth != null;

      // 申請作成は認証済みユーザーのみ
      allow create: if request.auth != null;

      // 現行の管理画面運用に合わせ、申請更新は認証済みユーザーに許可
      allow update: if request.auth != null;

      // 申請削除は認証済みユーザーに許可
      allow delete: if request.auth != null;
    }

    // ============================================================
    // 承認済み代表者（V2 - レガシー互換）
    // groupRepresentatives/{groupId_userId}
    // ============================================================
    match /groupRepresentatives/{representativeId} {
      allow read: if request.auth != null;

      // 現行の管理画面運用に合わせ、作成/更新/削除は認証済みユーザーに許可
      allow write: if request.auth != null;
    }

    // ============================================================
    // 団体マスターデータ・代表者管理
    // groups/{groupId}
    // ============================================================
    match /groups/{groupId} {
      // 認証済みユーザーなら誰でも読める（代表者の存在確認に使用）
      allow read: if request.auth != null;

      // 書き込みは認証済みユーザーに許可（代表者追加・パスワード設定）
      allow write: if request.auth != null;
    }

    // ============================================================
    // イベント
    // events/{eventId}
    // ============================================================
    match /events/{eventId} {
      // イベント一覧/詳細は誰でも閲覧可能
      allow read: if true;

      // イベント作成はログイン済みユーザーのみ
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;

      // 更新・削除は作成者本人のみ
      allow update, delete: if request.auth != null
        && resource.data.createdBy == request.auth.uid;
    }

    // ============================================================
    // その他のコレクション
    // ============================================================
    // デフォルトで拒否（暗黙的）

    // ============================================================
    // ヘルパー関数
    // ============================================================

    /**
     * 時間割ドキュメントのバリデーション
     * lectures Map の更新として検証。Firestoreルールの制限により最小限の型チェック。
     */
    function isValidTimetableWrite() {
      // 削除操作は常に許可
      return request.method == 'delete'
        // 作成・更新時は想定されたトップレベルフィールドをもつことを検証
        || (
          request.resource.data.keys().hasAny(['lectures', 'updatedAt'])
        );
    }

  }
}
